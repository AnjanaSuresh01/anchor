# Which LLM backend: anthropic | openai | openrouter | ollama
ANCHOR_LLM_PROVIDER=openrouter

# Only the key for your chosen provider is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Model override. Blank uses the provider default (see anchor/llm.py).
#   anthropic  -> claude-opus-5
#   openrouter -> openai/gpt-oss-20b:free
ANCHOR_LLM_MODEL=

# OpenAI-compatible gateway endpoint. Blank is correct for openrouter
# (it defaults to https://openrouter.ai/api/v1) and for plain openai.
ANCHOR_LLM_BASE_URL=

# Ollama only — ignored for the API providers.
OLLAMA_BASE_URL=http://localhost:11434

# Qdrant. Leave ANCHOR_QDRANT_URL blank to run embedded (local file, no Docker).
ANCHOR_QDRANT_URL=
ANCHOR_QDRANT_PATH=data/qdrant
