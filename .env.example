# Which LLM backend to use: anthropic | openai | ollama
ANCHOR_LLM_PROVIDER=anthropic

# Only the key for your chosen provider is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model override. Leave blank to use the provider default (see anchor/llm.py).
ANCHOR_LLM_MODEL=

# Ollama only — ignored for the API providers.
OLLAMA_BASE_URL=http://localhost:11434

# Qdrant. Leave ANCHOR_QDRANT_URL blank to run embedded (local file, no Docker).
ANCHOR_QDRANT_URL=
ANCHOR_QDRANT_PATH=data/qdrant
